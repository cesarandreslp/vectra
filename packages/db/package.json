{
  "name": "@vectra/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:create-superadmin": "tsx src/create-superadmin.ts",
    "db:create-user": "tsx src/create-user.ts",
    "db:create-test-users": "tsx src/create-test-users.ts",
    "db:migrate-leaders-to-voters": "tsx src/migrate-leaders-to-voters.ts",
    "db:seed-candidato-buga": "tsx src/seed-candidato-buga.ts",
    "db:migrate-tenants": "tsx src/migrate-tenants.ts",
    "db:import-territorio-buga": "tsx src/import-territorio-buga.ts",
    "db:import-comunas-boundary": "tsx src/import-comunas-boundary.ts",
    "db:import-corregimientos-y-barrios": "tsx src/import-corregimientos-y-barrios.ts",
    "db:import-puestos-buga": "tsx src/import-puestos-buga.ts",
    "db:geocodificar-puestos-buga": "tsx src/geocodificar-puestos-buga.ts",
    "db:resolver-barrios": "tsx src/resolver-barrios.ts",
    "db:sembrar-red-prueba-buga": "tsx src/sembrar-red-prueba-buga.ts",
    "db:sembrar-testigos-prueba": "tsx src/sembrar-testigos-prueba.ts",
    "db:backfill-qr-electores": "tsx src/backfill-qr-electores.ts",
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10",
    "@prisma/adapter-neon": "^6",
    "@prisma/client": "^6",
    "bcryptjs": "^2",
    "prisma": "^6",
    "ws": "^8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/ws": "^8",
    "dotenv": "^7",
    "tsx": "^4",
    "typescript": "^5"
  }
}
