// Prisma schema — CampaignOS
// Documentación: https://pris.ly/d/prisma-schema
//
// TODO: En una versión futura, separar en dos archivos:
//   - prisma/superadmin.schema.prisma  → modelos del panel de administración
//   - prisma/tenant.schema.prisma      → modelos de cada campaña (tenant)
// Por ahora ambos conjuntos de modelos conviven en este único schema.

generator client {
  provider      = "prisma-client-js"
  // driverAdapters es estable desde Prisma 6 — sin preview flag.
  // binaryTargets incluye el target de Vercel serverless (rhel-openssl-3.0.x)
  // además del nativo para desarrollo local.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL es el estándar de Prisma para comandos CLI (migrate dev, migrate deploy, studio)
  // El cliente de runtime en src/index.ts usa DATABASE_URL_SUPERADMIN directamente (ver Pool constructor)
  url      = env("DATABASE_URL")
}

// ─── ENUMERACIONES ────────────────────────────────────────────────────────────

/// Roles del sistema. Define qué rutas y datos puede acceder cada usuario.
enum UserRole {
  SUPERADMIN // Acceso total a la plataforma y todos los tenants
  ADMIN_CAMPANA // Administrador de una campaña específica
  COORDINADOR // Coordinador de zona o municipio
  LIDER // Líder comunitario con red de electores
  TESTIGO // Testigo electoral en mesa de votación
  // Sus permisos reales viven en CustomRole/CustomRolePermission (User.customRoleId) —
  // usado tanto para roles del "primer anillo" (agenda, logística, rutas) como para
  // el candidato/jefe de debate con una cuenta de staff de solo lectura total.
  PERSONALIZADO
}

/// Estado de compromiso de voto de un elector — funnel de contacto
enum CommitmentStatus {
  SIN_CONTACTAR // Aún no se ha hecho ningún contacto
  CONTACTADO // Se hizo contacto pero sin posición definida
  SIMPATIZANTE // Muestra interés positivo en la campaña
  COMPROMETIDO // Ha prometido su voto
  VOTO_SEGURO // Compromiso firme y confirmado
}

/// Tipo de división político-administrativa
enum CommuneType {
  COMUNA // Zona urbana
  CORREGIMIENTO // Zona rural
}

/// Estado de conversación de un elector en una encuesta
enum ConversationState {
  PENDIENTE
  CONTACTADO
  CONSENTIMIENTO_PENDIENTE
  CONSENTIDO
  RESPONDIENDO
  COMPLETADO
  RECHAZADO
}

/// Ámbito de agenda que administra un gestor. Son dos agendas separadas con
/// gestores distintos: la del candidato (su asistente, y la única reservable
/// por electores) y la de los jefes de debate (otra persona, sin electores).
enum AgendaAmbito {
  CANDIDATO
  JEFES
}

/// Estado operativo de un líder en la campaña
enum LeaderStatus {
  ACTIVO // Operando normalmente
  INACTIVO // Temporalmente fuera de operación
  SUSPENDIDO // Suspendido de la campaña
}

// ─── MODELOS SUPERADMIN ───────────────────────────────────────────────────────
// Estos modelos viven en la DB del superadmin y gestionan la plataforma.

/// Tenant = una campaña electoral registrada en la plataforma.
/// Cada tenant tiene su propia base de datos aislada en Neon.
model Tenant {
  id               String   @id @default(cuid())
  slug             String   @unique // Identificador URL amigable (ej: "campana-gomez-2026")
  name             String // Nombre visible de la campaña
  domain           String?  @unique // Dominio propio del cliente (opcional)
  // CIFRADO: este campo se cifra con AES-256 antes de persistir. Ver lib/crypto.ts
  connectionString String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  modules TenantModule[]
}

/// Módulos activos para cada tenant. Se inyectan en la sesión del usuario.
/// Los módulos inactivos no son accesibles aunque el usuario intente la ruta.
model TenantModule {
  id        String  @id @default(cuid())
  tenantId  String
  moduleKey String // Ej: "CORE", "ANALYTICS", "DIA_E", "FORMACION", etc.
  isActive  Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleKey])
}

/// Material global de formación gestionado desde el panel superadmin.
/// Se almacena en Vercel Blob bajo formacion/global/{filename}.
/// Los tenants con módulo FORMACION activo pueden ver estos materiales,
/// y opcionalmente ocultarlos o reordenarlos via TenantMaterialPreference.
model GlobalTrainingMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // SLIDES | PDF | VIDEO | INFOGRAFIA
  fileUrl     String
  fileSize    Int?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─── MODELOS TENANT — MÓDULO CORE ────────────────────────────────────────────
// Estos modelos se replican en la DB de cada tenant.
// Son obligatorios y siempre están presentes.

/// Usuario del sistema. Vive ÚNICAMENTE en la DB del superadmin (control plane).
/// Su tenantId apunta al Tenant correspondiente, o al sentinel '__superadmin__'
/// para el rol SUPERADMIN.
///
/// La autenticación es global: un email pertenece a UN solo tenant en toda la
/// plataforma. El authorize busca el user por email sin necesidad de subdominio.
model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String? // Nombre completo (opcional para no romper registros existentes)
  email        String   @unique // Único en toda la plataforma — login universal
  passwordHash String // Nunca almacenar contraseña en texto plano
  role         UserRole
  // Referencia suelta al Voter.id de este usuario en SU base de tenant (User vive
  // en la DB del superadmin, Voter en la del tenant — no puede ser @relation).
  // Para roles LIDER/TESTIGO: acota qué ve a su propio sub-árbol de electores.
  voterId      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  // Solo tiene sentido si role = PERSONALIZADO — de dónde salen sus permisos reales.
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])

  @@index([tenantId])
}

/// Rol personalizado armado por el ADMIN_CAMPANA de un tenant — nombre +
/// matriz de permisos por pantalla (CustomRolePermission). Vive en la DB del
/// superadmin, junto a User, porque se resuelve en cada login.
model CustomRole {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  permissions CustomRolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Permiso de un CustomRole sobre una pantalla puntual (ver apps/web/lib/screens.ts
/// para el registro de screenKeys válidos). canEdit sin canView no tiene efecto —
/// la UI de armado de roles no debería permitirlo, pero el check en runtime solo
/// mira el campo relevante a la acción pedida.
model CustomRolePermission {
  id        String  @id @default(cuid())
  roleId    String
  screenKey String
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, screenKey])
}

/// Elector registrado en la campaña. "Líder" es un rol implícito: cualquier
/// Voter con >=1 follower (alguien con `leaderId` apuntando a él) actúa como
/// líder — no es una entidad propia. Un líder puede a su vez ser liderado por
/// otro líder (multinivel), vía el mismo campo `leaderId` encadenado.
/// Los campos PII (cédula, teléfono) van cifrados en la capa de aplicación.
model Voter {
  id               String           @id @default(cuid())
  tenantId         String
  // CIFRADO: campo PII (número de cédula) — se cifra con AES-256 antes de persistir. Ver lib/crypto.ts
  cedula           String
  // SHA-256 de la cédula en texto plano. Permite deduplicación sin exponer el valor original.
  // Se calcula con: createHash('sha256').update(cedula.trim()).digest('hex')
  cedulaHash       String?
  name             String
  apodo            String? // Como le dicen normalmente — para mensajes de invitación más cercanos
  // CIFRADO: campo PII — se cifra con AES-256 antes de persistir. Ver lib/crypto.ts
  phone            String?
  address          String? // Dirección física del elector
  lat              Float? // Coordenada geocodificada desde address (para el mapa)
  lng              Float?
  leaderId         String? // Líder responsable de este elector
  // Campos de rol de líder — solo tienen sentido si este Voter tiene followers (ver abajo).
  // "Ser líder" es implícito: cualquier Voter con >=1 follower actúa como líder.
  zone             String? // Zona geográfica bajo su responsabilidad (si es líder)
  targetVotes      Int              @default(0) // Meta de votos a conseguir (si es líder)
  status           LeaderStatus     @default(ACTIVO)
  // El candidato es el líder natural en la raíz del árbol, pero no es un "líder" de
  // campaña — se excluye del panel de líderes y del ranking (sigue contando para
  // el sub-árbol de quien sí aparece). A lo sumo uno por tenant.
  isCandidate      Boolean          @default(false)
  // "Jefe de debate" — además del candidato, el admin puede marcar a otros con
  // agenda propia. OJO: solo la del candidato es reservable por electores.
  tieneAgenda      Boolean          @default(false)
  // Quien ADMINISTRA una agenda, que no es quien la protagoniza: el asistente
  // del candidato lleva el 100% de la suya, y otra persona lleva la de los
  // jefes de debate. El anfitrión ve su agenda pero no la escribe. Si nadie
  // tiene el ámbito, el admin del tenant queda como respaldo (ver lib/agenda).
  gestionaAgenda   AgendaAmbito?
  // Solo significa algo en el candidato: si su agenda está abierta para que
  // los electores reserven. La abre y la cierra su gestor, según haya espacios
  // por cubrir o por orden del candidato.
  agendaAbierta    Boolean          @default(false)
  // Simpatizante: subconjunto de electores que ejecuta actividades sociales de
  // la campaña. Todo simpatizante es elector, no todo elector es simpatizante.
  esSimpatizante   Boolean          @default(false)
  votingTableId    String? // Mesa donde está inscrito
  commitmentStatus CommitmentStatus @default(SIN_CONTACTAR)
  lastContact      DateTime? // Último contacto registrado
  notes            String? // Notas del líder sobre el elector
  // Árbol de captación por referidos
  referredById     String? // FK al Voter que refirió a esta persona
  captureDepth     Int              @default(0) // Nivel en el árbol de captación (0 = directo del líder)
  qrTokenUsed      String? // Token del QR que usó para registrarse
  createdAt        DateTime         @default(now())

  // Módulo Encuestas
  conversationState  ConversationState  @default(PENDIENTE)
  consent            Boolean            @default(false)
  surveyContactDate  DateTime?
  surveyResponseDate DateTime?
  surveyResponses    SurveyResponse[]
  surveyMessageLogs  SurveyMessageLog[]
  pushSubscriptions  VoterPushSubscription[]
  meetingAttendances MeetingAttendance[]

  // Agenda reservable (candidato / jefes de debate) y convocatorias top-down
  agendaPropia            AgendaEntrada[]             @relation("AgendaAnfitrion")
  agendaReservas          AgendaEntrada[]              @relation("AgendaReservante")
  aperturasAgendaPropia   AgendaApertura[]            @relation("AgendaAperturaAnfitrion")
  aperturasAgendaGestion  AgendaApertura[]            @relation("AgendaAperturaGestor")
  convocatoriasCreadas    Convocatoria[]
  convocatoriasRecibidas  ConvocatoriaDestinatario[]

  // Actividades sociales: grupos temporales que coordina o integra
  gruposCoordinados       GrupoActividad[]           @relation("GrupoResponsable")
  membresiasGrupo         MiembroGrupo[]             @relation("MiembroGrupoVoter")
  actividadesADoliente    Actividad[]                @relation("ActividadDoliente")

  leader      Voter?       @relation("VoterHierarchy", fields: [leaderId], references: [id])
  followers   Voter[]      @relation("VoterHierarchy")
  votingTable VotingTable? @relation(fields: [votingTableId], references: [id])
  referredBy  Voter?       @relation("VoterReferrals", fields: [referredById], references: [id])
  referrals   Voter[]      @relation("VoterReferrals")

  // Un elector no puede estar duplicado dentro del mismo tenant (por cédula cifrada)
  @@unique([tenantId, cedula])
  // Deduplicación por SHA-256 de cédula — permite búsqueda rápida de duplicados
  @@unique([tenantId, cedulaHash])
  @@index([tenantId, leaderId])
  @@index([tenantId, commitmentStatus])
}

/// QR de captación generado por un líder. El token genera la URL pública de registro.
model QrRegistration {
  id                 String    @id @default(cuid())
  tenantId           String
  leaderId           String
  token              String    @unique // crypto.randomUUID() — siempre generado en el servidor
  isActive           Boolean   @default(true)
  expiresAt          DateTime? // null = sin vencimiento
  registrationsCount Int       @default(0) // Incrementa con cada registro exitoso
  createdAt          DateTime  @default(now())

  @@unique([tenantId, token])
  @@index([tenantId, leaderId])
}

/// Alerta de cédula duplicada entre dos líderes.
/// Nunca contiene la cédula en texto plano — solo su SHA-256.
model VoterDuplicateAlert {
  id                String   @id @default(cuid())
  tenantId          String
  cedulaHash        String // SHA-256 de la cédula — NUNCA la cédula en plano
  firstLeaderId     String // Líder que la registró primero
  duplicateLeaderId String // Líder que intentó registrarla después
  status            String   @default("PENDIENTE") // PENDIENTE | REVISADA
  detectedAt        DateTime @default(now())

  @@index([tenantId, cedulaHash])
}

/// Notificación para un usuario del tenant.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  type      String // DUPLICADO_ELECTOR | QR_REGISTRO | etc.
  message   String
  isRead    Boolean  @default(false)
  metadata  Json? // Datos adicionales según el tipo
  createdAt DateTime @default(now())

  @@index([tenantId, userId, isRead])
}

// ─── ESTRUCTURA TERRITORIAL DIVIPOLA ─────────────────────────────────────────
// Jerarquía: Departamento → Municipio → Comuna/Corregimiento → Barrio/Vereda
// Los códigos DIVIPOLA son los oficiales del DANE de Colombia.

/// Departamento de Colombia. Código DIVIPOLA de 2 dígitos.
model Department {
  id   String @id @default(cuid())
  code String @unique // Ej: "05" para Antioquia
  name String // Ej: "Antioquia"

  municipalities Municipality[]
}

/// Municipio con código DIVIPOLA. Unidad básica electoral en Colombia.
model Municipality {
  id           String @id @default(cuid())
  divipola     String @unique // Código de 5 dígitos. Ej: "05001" para Medellín
  name         String
  departmentId String
  // Centro del municipio, para encuadrar los mapas antes de que haya datos
  // propios que encuadrar. Se rellena geocodificando una sola vez, la primera
  // vez que hace falta (ver getCentroMunicipio).
  lat          Float?
  lng          Float?

  department     Department      @relation(fields: [departmentId], references: [id])
  communes       Commune[]
  votingStations VotingStation[]
}

/// Comuna (zona urbana) o corregimiento (zona rural) dentro de un municipio.
model Commune {
  id             String      @id @default(cuid())
  name           String
  type           CommuneType // COMUNA o CORREGIMIENTO
  municipalityId String
  boundary       Json? // Polígono real: array de [lat, lng] (orden Leaflet), sin huecos

  municipality  Municipality   @relation(fields: [municipalityId], references: [id])
  neighborhoods Neighborhood[]
}

/// Barrio (zona urbana) o vereda (zona rural) dentro de una comuna/corregimiento.
model Neighborhood {
  id        String @id @default(cuid())
  name      String
  communeId String
  boundary  Json? // Polígono real: array de [lat, lng] (orden Leaflet), sin huecos

  commune Commune @relation(fields: [communeId], references: [id])
}

/// Puesto de votación. Lugar físico donde se instalan las mesas.
model VotingStation {
  id             String  @id @default(cuid())
  name           String // Ej: "Institución Educativa San José"
  address        String
  municipalityId String
  lat            Float? // Latitud para mapa de calor
  lng            Float? // Longitud para mapa de calor
  specialLabel   String? // null = puesto normal. Con texto = especial: "Cárcel", "Base militar", etc.

  municipality Municipality  @relation(fields: [municipalityId], references: [id])
  tables       VotingTable[]
}

/// Mesa de votación dentro de un puesto. Unidad mínima del sistema electoral.
model VotingTable {
  id            String @id @default(cuid())
  number        Int // Número de mesa dentro del puesto
  stationId     String
  voterCapacity Int    @default(0) // Capacidad máxima de electores por mesa

  station VotingStation @relation(fields: [stationId], references: [id])
  voters  Voter[]

  // No puede haber dos mesas con el mismo número en el mismo puesto
  @@unique([stationId, number])
}

// ─── MODELOS TENANT — MÓDULO ANALYTICS ───────────────────────────────────────
// Modelos específicos del módulo de Analítica e Inteligencia.

/// Análisis de fidelidad de un líder generado por el agente IA (Zhipu Flash).
/// Se cachea por 24 horas — si ya existe uno reciente, no se vuelve a llamar a la IA.
model LeaderAnalysis {
  id                String   @id @default(cuid())
  tenantId          String
  leaderId          String
  perfilTipo        String // Leal | Oportunista | Transaccional | Maximizador | DesertorPotencial
  indiceFidelidad   Int // 0-100
  indiceRiesgo      Int // 0-100
  veredicto         String // FIDELIZAR | MONITOREAR | PRESCINDIR
  planAccion        Json? // null si veredicto es PRESCINDIR
  senalesDetectadas Json // Array de { señal, peso: ALTO|MEDIO|BAJO }
  justificacion     String
  generadoEn        DateTime @default(now())

  @@index([tenantId, leaderId, generadoEn])
}

/// Análisis de compromiso de un ELECTOR (no líder) generado por el agente IA
/// (Groq) — mismo patrón que LeaderAnalysis, evaluando encuestas + reuniones
/// + masificación (ver lib/compromiso.ts para el índice heurístico que se le
/// pasa como contexto). Se cachea por 24 horas.
model CompromisoAnalysis {
  id                String   @id @default(cuid())
  tenantId          String
  voterId           String
  perfilTipo        String // Activista | Participativo | Ocasional | Desconectado
  indiceCompromiso  Int // 0-100
  veredicto         String // COMPROMETIDO | EN_SEGUIMIENTO | EN_RIESGO
  planAccion        Json? // null si veredicto es COMPROMETIDO (ya está aportando)
  senalesDetectadas Json // Array de { señal, peso: ALTO|MEDIO|BAJO }
  justificacion     String
  generadoEn        DateTime @default(now())

  @@index([tenantId, voterId, generadoEn])
}

/// Cargo de elección popular al que aspira el candidato de la campaña.
enum ElectionOffice {
  ALCALDE
  CONCEJAL
  GOBERNADOR
  DIPUTADO
  REPRESENTANTE
  SENADOR
  PRESIDENTE
}

/// Configuración del tenant para el módulo de Analytics.
/// Almacena parámetros configurables por campaña: fechas, metas, históricos.
model TenantConfig {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  fechaEleccion         DateTime?
  metaVotos             Int?
  votosEleccionAnterior Int?
  smtpConfig            Json? // { host, port, secure, user, passwordEncrypted, from }

  // Alcance electoral — acota el universo de electores para veracidad/proyecciones.
  // Referencia suelta por código (no @relation) para no acoplar TenantConfig a Department/Municipality.
  electionCountry              String          @default("Colombia")
  electionOffice               ElectionOffice?
  electionDepartmentCode       String? // Department.code
  electionMunicipalityDivipola String? // Municipality.divipola

  // Configuración Módulo Encuestas (WhatsApp & Limites)
  // Apaga el canal WhatsApp sin borrar las credenciales guardadas — la fuente
  // principal es la respuesta in-app, WhatsApp queda opcional por switch.
  whatsappSurveyEnabled Boolean @default(true)
  whatsappToken       String?
  whatsappPhoneId     String?
  whatsappVerifyToken String?
  botName             String? @default("Asistente Virtual")
  surveyDailyLimit    Int     @default(250)

  // IA por campaña — CIFRADAS en reposo (AES-256-GCM). Si están vacías, se usan
  // las claves globales del sistema (GROQ_API_KEY / ZHIPU_API_KEY del entorno).
  groqApiKey  String?
  zhipuApiKey String?

  // Branding por campaña
  logoUrl      String? // URL del logo en Vercel Blob
  primaryColor String? // color primario en hex, ej "#7d2839"

  updatedAt DateTime @updatedAt
}

// ─── MODELOS TENANT — MÓDULO FORMACIÓN ───────────────────────────────────────
// Modelos específicos del módulo de Formación y Capacitación.

/// Preferencia de un tenant sobre un material global de formación.
/// Permite ocultar materiales globales o cambiar su orden de presentación.
model TenantMaterialPreference {
  id               String  @id @default(cuid())
  tenantId         String
  globalMaterialId String // Referencia al GlobalTrainingMaterial en la DB superadmin
  isHidden         Boolean @default(false)
  customOrder      Int?

  @@unique([tenantId, globalMaterialId])
}

/// Material de formación propio del tenant (subido por ADMIN_CAMPANA).
/// Se muestra DESPUÉS de los materiales globales en la vista del testigo.
model TrainingMaterial {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  type        String // SLIDES | PDF | VIDEO | INFOGRAFIA
  fileUrl     String // URL de Vercel Blob o URL externa
  fileSize    Int?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

/// Sesión de capacitación programada por el admin del tenant.
model TrainingSession {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  date        DateTime // Fecha y hora de la sesión
  location    String? // Lugar físico o "Virtual"
  maxCapacity Int? // null = sin límite
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  attendances TrainingAttendance[]

  @@index([tenantId])
}

/// Registro de asistencia a una sesión de capacitación.
model TrainingAttendance {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  userId    String // Usuario que asistió (rol TESTIGO normalmente)
  attended  Boolean  @default(false) // Confirmado por el admin
  createdAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, userId])
  @@index([tenantId, userId])
}

/// Evaluación / Quiz creado por el admin del tenant.
/// Las preguntas se almacenan en QuizQuestion.
model Quiz {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  description  String?
  passingScore Int      @default(60) // Porcentaje mínimo para aprobar (0-100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([tenantId])
}

/// Pregunta de un quiz. correctIndex NUNCA se envía al cliente.
/// El endpoint getQuizForUser excluye este campo explícitamente.
model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  text         String // Enunciado de la pregunta
  options      Json // String[] con las opciones (4 típicamente)
  correctIndex Int // Índice de la respuesta correcta (0-based)
  order        Int    @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

/// Intento de un usuario en un quiz. Se permite múltiples intentos.
/// Las respuestas y el scoring se procesan server-side.
model QuizAttempt {
  id        String   @id @default(cuid())
  tenantId  String
  quizId    String
  userId    String
  answers   Json // Int[] — índice seleccionado por pregunta (en orden)
  score     Int // Porcentaje obtenido (0-100)
  passed    Boolean // score >= quiz.passingScore
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id])

  @@index([tenantId, userId])
  @@index([quizId, userId])
}

/// Certificado emitido a un testigo que aprobó una evaluación.
/// El PDF se genera con @react-pdf/renderer y se almacena en Vercel Blob.
model Certificate {
  id       String   @id @default(cuid())
  tenantId String
  userId   String
  quizId   String
  pdfUrl   String // URL del PDF en Vercel Blob
  issuedAt DateTime @default(now())

  @@unique([tenantId, userId, quizId])
  @@index([tenantId, userId])
}

// ─── MODELOS TENANT — MÓDULO DÍA E ──────────────────────────────────────────
// Modelos específicos del módulo de Operación Electoral.

/// Candidato configurado para la elección del tenant.
/// El orden determina cómo aparecen en el formulario E-14.
/// Candidato del tarjetón, tal como aparece en el E-14 físico. Para alcaldía,
/// gobernación y presidencia la foto y la agrupación NO son opcionales: es
/// como el testigo identifica el renglón en el acta impresa (ver docs/e14.webp).
model Candidate {
  id            String  @id @default(cuid())
  tenantId      String
  name          String
  party         String? // agrupación: partido o movimiento
  partyLogoUrl  String? // logo de la agrupación — Vercel Blob
  photoUrl      String? // foto del candidato — Vercel Blob
  isOwn         Boolean @default(false) // true = nuestro candidato (se sincroniza de Voter.isCandidate)
  order         Int     @default(0) // número en el tarjetón

  @@index([tenantId])
}

/// Asignación de un testigo a una mesa de votación.
/// isPrimary=true es el testigo titular, false es suplente.
/// Estado del testigo dentro del trámite ante la Registraduría.
/// El listado se propone, la Registraduría lo devuelve con o sin cambios, y
/// al aceptar las correcciones solo se tocan los testigos que efectivamente
/// cambiaron (ver aplicarCorreccionesRegistraduria).
enum EstadoTestigo {
  PROPUESTO // en el listado enviado a la Registraduría, sin respuesta todavía
  APROBADO // confirmado por la Registraduría (puede haber quedado en otra mesa)
  RECHAZADO // no apareció en el listado aprobado
}

model WitnessAssignment {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String // testigo asignado
  votingTableId String // mesa VIGENTE (tras aplicar correcciones, la aprobada)
  isPrimary     Boolean   @default(true) // false = suplente
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  estado                 EstadoTestigo @default(PROPUESTO)
  /// Mesa con la que se propuso originalmente. Se llena solo si la
  /// Registraduría la cambió, para poder mostrar "de la mesa X a la Y".
  votingTableIdPropuesto String?
  /// Nota de la corrección (ej. motivo del rechazo informado por la Registraduría).
  observacion            String?
  /// Cuándo se aplicó la respuesta de la Registraduría a este testigo.
  resueltoAt             DateTime?

  @@unique([tenantId, votingTableId, isPrimary])
  @@index([tenantId, userId])
}

/// Transmisión del formulario E-14 para una mesa de votación.
/// Almacena datos manuales, datos extraídos por IA, y verificación cruzada.
/// groqResult y zhipuResult son para auditoría — NUNCA se retornan al cliente.
model E14Transmission {
  id            String @id @default(cuid())
  tenantId      String
  votingTableId String @unique // una transmisión por mesa
  witnessUserId String

  // Datos digitados manualmente por el testigo
  manualData        Json? // { candidateId: string, votes: number }[]
  manualTotal       Int?
  manualSubmittedAt DateTime?

  // Bloque "NIVELACIÓN DE LA MESA" del E-14 físico — es la reconciliación que
  // prueba que el conteo cuadra: cuánta gente votó (E-11) vs cuántos votos
  // había en la urna. Si difieren, el acta tiene una inconsistencia que hay
  // que reclamar en la mesa, no después.
  nivelacionE11         Int? // TOTAL VOTANTES FORMULARIO E-11
  nivelacionUrna        Int? // TOTAL VOTOS DEL CARGO EN LA URNA
  nivelacionIncinerados Int? // TOTAL VOTOS INCINERADOS

  // Datos extraídos de la foto por IA
  photoUrl             String? // URL en Vercel Blob
  extractedData        Json? // { candidateId: string, votes: number }[]
  extractedTotal       Int?
  extractionConfidence String? // ALTA | MEDIA | BAJA
  groqResult           Json? // resultado crudo de Groq — solo auditoría
  zhipuResult          Json? // resultado crudo de Zhipu — solo auditoría
  photoSubmittedAt     DateTime?

  // Tercera fuente OBLIGATORIA: lo publicado por la Registraduría, sea por
  // scraping de su página de resultados o cargado a mano si el scraping no
  // está disponible para esa elección.
  registraduriaData   Json? // { candidateId: string, votes: number }[]
  registraduriaTotal  Int?
  registraduriaAt     DateTime?
  registraduriaFuente String? // SCRAPING | CARGA_MANUAL

  // Verificación cruzada de las TRES fuentes (manual, foto, Registraduría).
  // Ninguna es opcional: mientras falte una, la mesa queda INCOMPLETA.
  verificationStatus String @default("PENDIENTE")
  // PENDIENTE | INCOMPLETA | VERIFICADO | DISCREPANCIA
  discrepancies      Json? // candidatos que no cuadran, con el valor de cada fuente

  // Estado final
  finalData   Json? // datos definitivos a reportar
  finalizedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, verificationStatus])
}

/// Incidente reportado desde campo durante la jornada electoral.
model Incident {
  id            String    @id @default(cuid())
  tenantId      String
  reportedBy    String // userId
  votingTableId String?
  type          String // IRREGULARIDAD | VIOLENCIA | FALTA_MATERIAL | AUSENCIA_TESTIGO | OTRO
  description   String
  severity      String    @default("MEDIA") // ALTA | MEDIA | BAJA
  photoUrl      String?
  status        String    @default("ABIERTO") // ABIERTO | EN_REVISION | RESUELTO
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status, severity])
}

/// Resultados electorales agregados por candidato (cache materializado).
/// Se recalcula a partir de E14Transmission con estado final.
model ElectionResult {
  id            String   @id @default(cuid())
  tenantId      String
  candidateId   String // identificador interno del candidato
  candidateName String
  totalVotes    Int      @default(0)
  tableCount    Int      @default(0) // mesas reportadas
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, candidateId])
}

// ─── MODELOS TENANT — MÓDULO COMUNICACIONES ─────────────────────────────────
// Modelos específicos del módulo de Comunicaciones (email, SMS, WhatsApp).

/// Plantilla de mensaje reutilizable. Soporta variables con sintaxis {{nombre}}.
model MessageTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  channel   String // EMAIL | SMS | WHATSAPP
  subject   String? // solo para EMAIL
  body      String // texto con variables {{nombre}}, {{municipio}}, etc.
  variables Json // string[] — lista de variables usadas en el body
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId, channel, isActive])
}

/// Campaña de envío masivo de mensajes.
/// Flujo: BORRADOR → PROGRAMADA → ENVIANDO → COMPLETADA | FALLIDA
model MessageCampaign {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  channel         String // EMAIL | SMS | WHATSAPP
  templateId      String
  segmentFilters  Json // { leaderId?, zone?, commitmentStatus?, role?, municipalityId? }
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          String    @default("BORRADOR")
  // BORRADOR | PROGRAMADA | ENVIANDO | COMPLETADA | FALLIDA
  totalRecipients Int       @default(0)
  totalSent       Int       @default(0)
  totalFailed     Int       @default(0)
  createdAt       DateTime  @default(now())

  messages Message[]

  @@index([tenantId, status])
}

/// Mensaje individual enviado a un destinatario.
/// El campo `to` siempre va CIFRADO con AES-256 — se descifra solo en el momento del envío.
model Message {
  id            String    @id @default(cuid())
  tenantId      String
  campaignId    String?
  channel       String // EMAIL | SMS | WHATSAPP
  recipientId   String // userId o voterId según recipientType
  recipientType String // USER | VOTER
  // CIFRADO: campo PII — contiene email o teléfono cifrado con AES-256
  to            String
  subject       String?
  body          String
  status        String    @default("PENDIENTE")
  // PENDIENTE | ENVIADO | FALLIDO | REBOTADO
  provider      String? // nombre del proveedor que lo envió
  providerMsgId String? // ID del mensaje en el proveedor externo
  sentAt        DateTime?
  failReason    String?
  createdAt     DateTime  @default(now())

  campaign MessageCampaign? @relation(fields: [campaignId], references: [id])

  @@index([tenantId, campaignId, status])
  @@index([tenantId, recipientId])
}

/// Regla de automatización de mensajes.
/// Se dispara ante eventos del sistema (nuevo elector, cambio de compromiso, etc.)
model AutomationRule {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  trigger      String // NUEVO_ELECTOR | CAMBIO_COMPROMISO | DIA_ELECCION | RECORDATORIO_VOTO
  channel      String // EMAIL | SMS | WHATSAPP
  templateId   String
  isActive     Boolean  @default(true)
  delayMinutes Int      @default(0)
  conditions   Json? // condiciones adicionales del trigger
  createdAt    DateTime @default(now())

  @@index([tenantId, trigger, isActive])
}

// ─── MODELOS TENANT — MÓDULO FINANZAS ───────────────────────────────────────
// Modelos específicos del módulo de Finanzas y Cumplimiento Electoral.
// Marco legal: Ley 1475/2011, Resoluciones del CNE.

/// Configuración financiera del tenant: datos del candidato, tesorero y tope legal.
/// cedulaTesorero y cuentaBancaria siempre CIFRADOS con AES-256.
model FinanceConfig {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  cargoPostulado     String? // Alcalde | Concejal | Diputado | Gobernador | Senador | Representante | Otro
  municipio          String?
  topeGastos         Float? // tope legal en pesos colombianos (COP)
  fechaInicioCampana DateTime?
  fechaFinCampana    DateTime?
  nombreTesorero     String?
  cedulaTesorero     String? // CIFRADO con encrypt() — nunca en texto plano
  cuentaBancaria     String? // CIFRADO con encrypt() — nunca en texto plano
  updatedAt          DateTime  @updatedAt
}

/// Gasto de campaña registrado por un usuario.
/// Categorías: PUBLICIDAD | TRANSPORTE | LOGISTICA | PERSONAL | TECNOLOGIA | EVENTOS | JURIDICO | OTRO
model Expense {
  id            String   @id @default(cuid())
  tenantId      String
  category      String // PUBLICIDAD | TRANSPORTE | LOGISTICA | PERSONAL | TECNOLOGIA | EVENTOS | JURIDICO | OTRO
  description   String
  amount        Float // en pesos colombianos (COP)
  date          DateTime
  vendor        String? // proveedor o beneficiario
  invoiceNumber String? // número de factura
  invoiceUrl    String? // URL del comprobante en Vercel Blob
  paymentMethod String? // EFECTIVO | TRANSFERENCIA | CHEQUE
  status        String   @default("REGISTRADO") // REGISTRADO | VERIFICADO | OBSERVADO
  registeredBy  String // userId que registró el gasto
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, category])
  @@index([tenantId, date])
}

/// Donación recibida por la campaña.
/// donorId (cédula o NIT) siempre CIFRADO — nunca se retorna en respuestas.
model Donation {
  id            String   @id @default(cuid())
  tenantId      String
  donorName     String
  donorId       String? // cédula o NIT — CIFRADO con encrypt()
  donorType     String   @default("PERSONA_NATURAL") // PERSONA_NATURAL | PERSONA_JURIDICA | APORTE_PROPIO
  amount        Float // en pesos colombianos (COP)
  date          DateTime
  paymentMethod String?
  bankReference String?
  receiptUrl    String? // URL del comprobante en Vercel Blob
  isVerified    Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, date])
}

/// Informe financiero generado para presentación al CNE u otro fin.
/// El PDF se genera con @react-pdf/renderer y se almacena en Vercel Blob.
model FinanceReport {
  id             String    @id @default(cuid())
  tenantId       String
  type           String // PARCIAL | FINAL | CNE
  period         String // ej: "2026-Q1" o "FINAL"
  totalExpenses  Float
  totalDonations Float
  balance        Float // donaciones - gastos
  status         String    @default("BORRADOR") // BORRADOR | GENERADO | PRESENTADO
  fileUrl        String? // URL del PDF en Vercel Blob
  generatedAt    DateTime?
  presentedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([tenantId, type])
}

// ─── MODELOS TENANT — MÓDULO ENCUESTAS ──────────────────────────────────────
// Modelos específicos del módulo de Encuestas vía WhatsApp (Electoss integrado)

/// Campaña de encuestas (puede ser 1 por elección)
model SurveyCampaign {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  electionDate    DateTime
  isActive        Boolean  @default(true)
  isSurveyEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cargos SurveyCargo[]

  @@index([tenantId])
}

/// Cargo electoral en la encuesta (ej: Alcaldía, Concejo)
model SurveyCargo {
  id               String @id @default(cuid())
  surveyCampaignId String
  name             String
  order            Int    @default(0)

  campaign   SurveyCampaign    @relation(fields: [surveyCampaignId], references: [id], onDelete: Cascade)
  preguntas  SurveyPregunta[]
  candidatos SurveyCandidato[]

  @@index([surveyCampaignId])
}

/// Tipo de pregunta en la encuesta
enum SurveyPreguntaType {
  FREE_TEXT
  BOOLEAN
  SINGLE_CHOICE
}

/// Pregunta asociada a un cargo en la encuesta
model SurveyPregunta {
  id            String             @id @default(cuid())
  surveyCargoId String
  text          String
  order         Int                @default(0)
  type          SurveyPreguntaType @default(FREE_TEXT)

  cargo     SurveyCargo      @relation(fields: [surveyCargoId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]
  opciones  SurveyOpcion[]

  @@index([surveyCargoId])
}

/// Opción fija para una pregunta SINGLE_CHOICE (no ligada a candidatos)
model SurveyOpcion {
  id               String @id @default(cuid())
  surveyPreguntaId String
  text             String
  order            Int    @default(0)

  pregunta  SurveyPregunta   @relation(fields: [surveyPreguntaId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([surveyPreguntaId])
}

/// Candidato oficial para un cargo electoral, usado para matcher IA
model SurveyCandidato {
  id            String  @id @default(cuid())
  surveyCargoId String
  name          String
  code          String? // Ej: "U 101"

  cargo     SurveyCargo      @relation(fields: [surveyCargoId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([surveyCargoId])
}

/// Respuesta de un elector a una pregunta, con posible mapeo IA a candidato
/// o selección directa de opción (preguntas SINGLE_CHOICE)
model SurveyResponse {
  id                String  @id @default(cuid())
  tenantId          String
  voterId           String
  surveyPreguntaId  String
  surveyCandidatoId String?
  surveyOpcionId    String?
  text              String

  voter     Voter            @relation(fields: [voterId], references: [id], onDelete: Cascade)
  pregunta  SurveyPregunta   @relation(fields: [surveyPreguntaId], references: [id], onDelete: Cascade)
  candidato SurveyCandidato? @relation(fields: [surveyCandidatoId], references: [id], onDelete: SetNull)
  opcion    SurveyOpcion?    @relation(fields: [surveyOpcionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([voterId, surveyPreguntaId])
  @@index([tenantId])
}

/// Tipo de mensaje de encuesta
enum SurveyMessageType {
  SENT
  RECEIVED
}

/// Registro detallado de la conversación de la encuesta con Meta API
model SurveyMessageLog {
  id        String            @id @default(cuid())
  tenantId  String
  voterId   String
  type      SurveyMessageType
  content   String
  messageId String? // ID devuelto por Meta/WhatsApp

  voter Voter @relation(fields: [voterId], references: [id], onDelete: Cascade)

  timestamp DateTime @default(now())

  @@index([voterId, messageId])
  @@index([tenantId])
}

/// Suscripción Web Push de un elector desde la PWA — para avisarle
/// "hay una nueva encuesta" sin depender de WhatsApp.
model VoterPushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  voterId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  voter Voter @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([voterId])
}

/// RED_INTERNA: reunión con la propia red ya registrada — cuenta para el
/// índice de compromiso (lib/compromiso.ts). RECLUTAMIENTO: reunión para
/// gente que podría adherirse a la campaña, todavía sin registrar — no
/// cuenta para el índice (sus asistentes no son Voter, ver MeetingProspecto).
enum MeetingTipo {
  RED_INTERNA
  RECLUTAMIENTO
}

/// Reunión convocada por un elector (líder implícito) — con su gente ya
/// registrada (RED_INTERNA, señal de compromiso) o con prospectos para
/// hacer crecer la base (RECLUTAMIENTO).
model Meeting {
  id        String      @id @default(cuid())
  tenantId  String
  leaderId  String // Voter que convocó
  title     String
  date      DateTime
  tipo      MeetingTipo @default(RED_INTERNA)
  createdAt DateTime    @default(now())

  attendees  MeetingAttendance[]
  prospectos MeetingProspecto[]

  @@index([tenantId, leaderId])
}

/// Asistencia confirmada de un elector YA REGISTRADO a una reunión RED_INTERNA
/// — la fila existe solo si asistió (lista de presentes, no de invitados).
model MeetingAttendance {
  id        String @id @default(cuid())
  meetingId String
  voterId   String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  voter   Voter   @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([meetingId, voterId])
  @@index([voterId])
}

/// Prospecto que asistió a una reunión de RECLUTAMIENTO — solo nombre/nota,
/// nunca crea un Voter. Si luego se une a la campaña, se registra aparte por
/// el flujo normal de QR/link (sin relación automática con esto).
model MeetingProspecto {
  id        String  @id @default(cuid())
  meetingId String
  name      String
  phone     String? // en texto plano — a diferencia de Voter.phone, no es un elector, es solo una nota de contacto
  notes     String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

/// Hueco de agenda del candidato o un "jefe de debate" (Voter.tieneAgenda) —
/// mismo modelo para lo que el anfitrión publica como disponible (sin
/// título, hasta reservarse) y lo que bloquea como compromiso propio
/// (con título, NUNCA visible para el elector). El elector solo consulta
/// disponible=true AND reservadoPor=null.
model AgendaEntrada {
  id           String   @id @default(cuid())
  tenantId     String
  anfitrionId  String // Voter con agenda propia (candidato o jefe de debate)
  startsAt     DateTime
  endsAt       DateTime
  disponible   Boolean // true = hueco publicado para reservar; false = compromiso privado del anfitrión
  titulo       String? // solo compromisos (disponible=false) — nunca se expone a electores
  reservadoPor String? // Voter del elector que reservó (solo si disponible=true)
  motivo       String? // lo que puso el elector al reservar
  createdAt    DateTime @default(now())
  // Dirección física de la entrada (para logística/ruta) — geocodificada con
  // el mismo mecanismo que Voter.address (ver lib/geocode.ts). lat/lng null
  // hasta que se geocodifique o si la dirección no se pudo resolver.
  direccion    String?
  lat          Float?
  lng          Float?
  ordenRuta    Int? // posición manual dentro de la ruta sugerida del día (null = sin definir)
  cumplido     Boolean  @default(false) // marcado por quien maneja la agenda al arrancar/completar la ruta

  anfitrion  Voter  @relation("AgendaAnfitrion", fields: [anfitrionId], references: [id], onDelete: Cascade)
  reservante Voter? @relation("AgendaReservante", fields: [reservadoPor], references: [id], onDelete: SetNull)

  @@index([tenantId, anfitrionId, startsAt])
}

/// Bitácora de aperturas y cierres de la agenda, append-only.
///
/// Existe porque el admin del tenant puede abrir la agenda cuando el ámbito no
/// tiene gestor, y eso puede dejar sin efecto un cierre pedido por el propio
/// candidato. Voter.agendaAbierta solo guarda el estado actual; esto guarda
/// quién lo cambió, cuándo y por qué.
model AgendaApertura {
  id          String   @id @default(cuid())
  tenantId    String
  anfitrionId String // de quién es la agenda que se abrió o cerró
  abierta     Boolean // true = se abrió, false = se cerró
  gestorId    String? // Voter del gestor del ámbito, cuando lo hizo él
  adminUserId String? // User del admin, cuando actuó como respaldo por no haber gestor
  motivo      String?
  createdAt   DateTime @default(now())

  anfitrion Voter  @relation("AgendaAperturaAnfitrion", fields: [anfitrionId], references: [id], onDelete: Cascade)
  gestor    Voter? @relation("AgendaAperturaGestor", fields: [gestorId], references: [id], onDelete: SetNull)

  @@index([tenantId, anfitrionId, createdAt])
}

// ── Actividades sociales ────────────────────────────────────────────────────────
// Jornadas que ejecutan los simpatizantes (brigadas de salud, vacunación de
// mascotas, chocolatadas, ambientales, etc.). Una actividad puede correr en
// varios lugares a la vez con grupos TEMPORALES distintos, cada uno con su
// propia logística (alimentación, insumos, materiales, herramientas). El estado
// APROBADO de un insumo es donde interviene el tesorero (presupuesto).

enum ActividadEstado {
  PLANEADA
  EN_CURSO
  REALIZADA
  CANCELADA
}

enum InsumoTipo {
  ALIMENTACION
  INSUMO
  MATERIAL
  HERRAMIENTA
}

enum InsumoEstado {
  REQUERIDO // pedido, falta conseguir/aprobar
  APROBADO // el tesorero confirmó presupuesto
  CONSEGUIDO // ya se tiene
}

/// Actividad social de campaña. El "qué" y el "cuándo"; el "dónde/quién" vive
/// en sus grupos.
model Actividad {
  id          String          @id @default(cuid())
  tenantId    String
  nombre      String
  categoria   String? // salud, mascotas, recreación, ambiental, etc.
  descripcion String?
  fecha       DateTime?
  estado      ActividadEstado @default(PLANEADA)
  // Doliente: el responsable de que la actividad ocurra. Obligatorio — no hay
  // actividad sin alguien que responda por ella. Restrict: no se puede borrar
  // al elector mientras tenga actividades a cargo (primero se reasignan).
  dolienteId  String
  createdAt   DateTime        @default(now())

  doliente Voter            @relation("ActividadDoliente", fields: [dolienteId], references: [id])
  grupos   GrupoActividad[]

  @@index([tenantId, dolienteId])
  @@index([tenantId, fecha])
  @@index([tenantId, estado])
}

/// Grupo temporal que ejecuta una actividad en un lugar puntual. Una actividad
/// puede tener varios; se arman para la ocasión y no persisten como estructura.
model GrupoActividad {
  id            String   @id @default(cuid())
  tenantId      String
  actividadId   String
  nombre        String // ej: "Parque San José" o "Brigada norte"
  lugar         String? // dirección o referencia del punto de ejecución
  responsableId String? // Voter que coordina el grupo
  createdAt     DateTime @default(now())

  actividad   Actividad      @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  responsable Voter?         @relation("GrupoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  miembros    MiembroGrupo[]
  insumos     InsumoGrupo[]

  @@index([tenantId, actividadId])
}

/// Un simpatizante asignado a un grupo temporal.
model MiembroGrupo {
  id       String @id @default(cuid())
  tenantId String
  grupoId  String
  voterId  String

  grupo GrupoActividad @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  voter Voter          @relation("MiembroGrupoVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([grupoId, voterId])
  @@index([tenantId, voterId])
}

/// Ítem de logística de un grupo. El tesorero aprueba (estado APROBADO) según
/// costoEstimado.
model InsumoGrupo {
  id            String       @id @default(cuid())
  tenantId      String
  grupoId       String
  descripcion   String
  tipo          InsumoTipo
  cantidad      Int          @default(1)
  costoEstimado Float? // lo revisa/aprueba el tesorero
  estado        InsumoEstado @default(REQUERIDO)
  createdAt     DateTime     @default(now())

  grupo GrupoActividad @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([tenantId, grupoId])
}

/// Convocatoria del candidato o un jefe de debate hacia electores (algunos o
/// todos) — a diferencia de Meeting (que convoca cualquier elector a su
/// propia gente), esto es específicamente la convocatoria "de arriba hacia
/// abajo" de la dirección de campaña.
model Convocatoria {
  id           String   @id @default(cuid())
  tenantId     String
  convocanteId String // Voter con agenda propia que convoca
  titulo       String
  startsAt     DateTime
  lugar        String? // nota/etiqueta libre (ej. "salón principal") — no se geocodifica
  createdAt    DateTime @default(now())
  // Dirección física real de la reunión, aparte de 'lugar' — geocodificada
  // igual que AgendaEntrada.direccion, para logística/ruta.
  direccion    String?
  lat          Float?
  lng          Float?
  ordenRuta    Int?
  cumplido     Boolean  @default(false)

  convocante    Voter                      @relation(fields: [convocanteId], references: [id], onDelete: Cascade)
  destinatarios ConvocatoriaDestinatario[]

  @@index([tenantId, convocanteId])
}

/// Un elector convocado a una Convocatoria — la fila existe para cada
/// destinatario, sea porque se eligió "todos" o una selección puntual.
model ConvocatoriaDestinatario {
  id             String @id @default(cuid())
  convocatoriaId String
  voterId        String

  convocatoria Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  voter        Voter        @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([convocatoriaId, voterId])
  @@index([voterId])
}
